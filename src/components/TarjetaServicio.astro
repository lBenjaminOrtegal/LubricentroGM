---
import { buttonVariants } from '@/components/ui/button';

interface Props {
  nombre: string;
  descripcion: string;
  precioMinimo: string;
}

const { nombre, descripcion, precioMinimo } = Astro.props;
---

<article class="flex h-full flex-col justify-between rounded-xl border border-border bg-card p-6 text-card-foreground shadow-sm transition-all duration-300 hover:shadow-md">
  <div class="space-y-3">
    <h3 class="line-clamp-2 font-bold uppercase tracking-tight text-foreground">
      {nombre}
    </h3>
    <p class="line-clamp-4 text-sm leading-relaxed text-muted-foreground">
      {descripcion}
    </p>
  </div>

  <div class="mt-6 flex items-center justify-between border-t border-border/50 pt-5">
    <div class="flex flex-col">
      <span class="text-xs text-muted-foreground uppercase tracking-wider">Desde</span>
      <span class="text-lg font-bold text-primary">$ {Number(precioMinimo).toLocaleString('es-CL')}</span>
    </div>

    <a
        href={`/cotizar?servicio=${encodeURIComponent(nombre)}`}
        class={buttonVariants({ variant: 'default', size: 'sm', className: 'font-semibold' })}
    >
      Cotizar
    </a>
  </div>
</article>