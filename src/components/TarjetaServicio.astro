---
interface Props {
  nombre: string;
  descripcion: string;
  precioMinimo: string;
}

const { nombre, descripcion, precioMinimo } = Astro.props;
---

<article class="flex flex-col justify-between border border-asfalto-800/10 bg-white p-6">
  <div>
    <h3 class="line-clamp-2 font-display text-lg font-semibold uppercase tracking-wide text-asfalto-900">
      {nombre}
    </h3>
    <p class="line-clamp-4 mt-2 text-sm leading-relaxed text-asfalto-700">{descripcion}</p>
  </div>
 
  <div class="mt-6 flex items-center justify-between border-t border-asfalto-800/10 pt-4">
    <span class="font-display text-base font-semibold text-senal">Desde $ {precioMinimo}</span>
    <a
      href={`/cotizar?servicio=${encodeURIComponent(nombre)}`}
      class="text-sm font-semibold text-asfalto-900 underline decoration-senal decoration-2 underline-offset-4 hover:text-senal"
    >
      Cotizar
    </a>
  </div>
</article>