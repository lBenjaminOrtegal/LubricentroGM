---
import { Image } from 'astro:assets';
import { linkWhatsapp } from '@/data/negocio';
import { buttonVariants } from '@/components/ui/button';

interface Props {
  id?: string | number;
  nombre: string;
  descripcion: string;
  precio: string;
  imagen_url?: string;
  imagenUrl?: string;
  categoria: string;
}

const { id, nombre, descripcion, precio, imagen_url, imagenUrl } = Astro.props;

const enlaceDetalle = `/productos/${id ?? encodeURIComponent(nombre.toLowerCase().replace(/\s+/g, '-'))}`;
---

<article class="group relative flex flex-col overflow-hidden rounded-xl border border-border bg-card text-card-foreground shadow-sm transition-all duration-300 hover:shadow-md">

  <a href={enlaceDetalle} class="aspect-4/3 w-full overflow-hidden bg-muted block">
    {imagenUrl ? (
        <Image
            src={imagenUrl}
            alt={nombre}
            width={400}
            height={300}
            format="webp"
            quality={80}
            loading="lazy"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
    ) : (
        <div class="flex h-full w-full items-center justify-center text-sm text-muted-foreground">
          Sin imagen
        </div>
    )}
  </a>

  <div class="flex flex-1 flex-col justify-between p-5">
    <div class="space-y-2">
      <a href={enlaceDetalle} class="hover:underline">
        <h3 class="line-clamp-2 font-bold uppercase tracking-tight text-foreground">
          {nombre}
        </h3>
      </a>
      <p class="line-clamp-3 text-sm text-muted-foreground leading-relaxed">
        {descripcion}
      </p>
    </div>

    <div class="mt-6 flex items-center justify-between">
      <span class="text-lg font-bold text-primary">$ {Number(precio).toLocaleString('es-CL')}</span>
      <a
          href={linkWhatsapp("¡Hola! Quería consultar por " + nombre + ". ¿Está disponible?")}
          target="_blank"
          rel="noopener noreferrer"
          class={buttonVariants({ variant: 'default', size: 'sm', className: 'font-semibold' })}
      >
        Consultar
      </a>
    </div>
  </div>
</article>