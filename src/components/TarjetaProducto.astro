---
import { Image } from 'astro:assets';
import { linkWhatsapp } from '../data/negocio.js';
import { resolverImagenProducto } from '../data/imagenes.js';

interface Props {
  nombre: string;
  descripcion: string;
  precio: string;
  imagenArchivo: string;
  whatsappMensaje: string;
}

const { nombre, descripcion, precio, imagenArchivo, whatsappMensaje } = Astro.props;
const imagenModulo = resolverImagenProducto(imagenArchivo);
---

<article class="flex flex-col border border-asfalto-800/10 bg-white">
  <div class="aspect-[4/3] w-full overflow-hidden bg-acero-100">
    {imagenModulo ? (
      <Image
        src={imagenModulo}
        alt={nombre}
        width={400}
        height={300}
        format="webp"
        quality={80}
        loading="lazy"
        class="h-full w-full object-cover"
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center text-xs text-acero-400">
        No se ha encontrado imagen
      </div>
    )}
  </div>

  <div class="flex flex-1 flex-col justify-between p-5">
    <div>
      <h3 class="font-display text-base font-semibold uppercase tracking-wide text-asfalto-900">
        {nombre}
      </h3>
      <p class="mt-1 text-sm text-asfalto-700">{descripcion}</p>
    </div>

    <div class="mt-5 flex items-center justify-between">
      <span class="font-display text-base font-semibold text-senal">{precio}</span>
      <a
        href={linkWhatsapp(whatsappMensaje)}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-semibold text-asfalto-900 underline decoration-senal decoration-2 underline-offset-4 hover:text-senal"
      >
        Consultar
      </a>
    </div>
  </div>
</article>