---
import Layout from "../../layouts/Layout.astro";
import BotonWhatsappFlotante from "../../components/BotonWhatsappFlotante.astro";
import TarjetaProducto from "../../components/TarjetaProducto.astro";
import { obtenerProductos } from "@/data/productos";
import { negocio, linkWhatsapp } from "@/data/negocio";
import { buttonVariants } from "@/components/ui/button";
import { Image } from "astro:assets";

export async function getStaticPaths() {
    const productos = await obtenerProductos();

    return productos.map((producto) => ({
        params: { id: String(producto.id) },
        props: {
            producto,
            relacionados: productos
                .filter((p) => p.categoria === producto.categoria && p.id !== producto.id)
                .slice(0, 4),
        },
    }));
}

const { producto, relacionados } = Astro.props;

if (!producto) {
    return Astro.redirect("/productos");
}

const mensajeConsulta = `¡Hola! Quería consultar por ${producto.nombre}. ¿Está disponible?`;
---

<Layout
        title={`${producto.nombre} | ${negocio.nombre}`}
        description={`${producto.descripcion.slice(0, 150)}... Consulta stock y precio en ${negocio.nombre}.`}
>
    <nav class="border-b bg-muted/40 py-3.5 text-sm text-muted-foreground">
        <div class="mx-auto flex max-w-7xl items-center gap-2 px-6">
            <a href="/" class="hover:text-foreground transition-colors">Inicio</a>
            <span>/</span>
            <a href="/productos" class="hover:text-foreground transition-colors">Productos</a>
            <span>/</span>
            <span class="font-medium text-foreground truncate max-w-xs sm:max-w-md">{producto.nombre}</span>
        </div>
    </nav>

    <section class="mx-auto max-w-7xl px-6 py-10 md:py-16">
        <div class="grid gap-10 md:grid-cols-2 md:gap-14 lg:gap-16">

            <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
                <div class="aspect-square sm:aspect-4/3 md:aspect-square w-full bg-muted">
                    {producto.imagenUrl ? (
                            <Image
                                    src={producto.imagenUrl}
                                    alt={producto.nombre}
                                    width={700}
                                    height={700}
                                    format="webp"
                                    quality={90}
                                    loading="eager"
                                    class="h-full w-full object-cover"
                            />
                    ) : (
                            <div class="flex h-full w-full items-center justify-center text-muted-foreground">
                                Sin imagen disponible
                            </div>
                    )}
                </div>
            </div>

            <div class="flex flex-col justify-between">
                <div class="space-y-6">
                    <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-full border border-border bg-muted px-3 py-1 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
              {producto.categoria === "ambos" ? "Auto & Moto" : `Mundo ${producto.categoria}`}
            </span>
                        <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-medium text-emerald-600">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
              Consultar disponibilidad en local
            </span>
                    </div>

                    <h1 class="text-3xl font-extrabold uppercase tracking-tight text-foreground sm:text-4xl">
                        {producto.nombre}
                    </h1>

                    <div class="flex items-baseline gap-3">
            <span class="text-3xl font-black text-primary sm:text-4xl">
              $ {producto.precio}
            </span>
                        <span class="text-xs text-muted-foreground uppercase font-medium">IVA Incluido / Precio ref.</span>
                    </div>

                    <div class="border-t border-b border-border py-4">
                        <h2 class="text-sm font-semibold uppercase tracking-wide text-foreground">
                            Descripción y detalles
                        </h2>
                        <p class="mt-2 whitespace-pre-line text-base text-muted-foreground leading-relaxed">
                            {producto.descripcion}
                        </p>
                    </div>

                    <ul class="space-y-2.5 text-sm text-muted-foreground">
                        <li class="flex items-center gap-2">
                            <svg class="h-4 w-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                            </svg>
                            Retiro inmediato en local ({negocio.direccion.comuna})
                        </li>
                        <li class="flex items-center gap-2">
                            <svg class="h-4 w-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                            </svg>
                            Asesoría técnica para la compatibilidad con tu motor
                        </li>
                    </ul>
                </div>

                <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                    <a
                            href={linkWhatsapp(mensajeConsulta)}
                            target="_blank"
                            rel="noopener noreferrer"
                            class={buttonVariants({
                                variant: "default",
                                size: "lg",
                                className: "w-full gap-2.5 font-bold uppercase tracking-wide sm:flex-1 shadow-md hover:shadow-lg transition-all",
                            })}
                    >
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
                            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.28-1.38a9.9 9.9 0 0 0 4.76 1.21h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm5.8 14.06c-.24.68-1.4 1.3-1.93 1.38-.5.08-1.12.11-1.8-.11-.42-.13-.95-.3-1.64-.6-2.88-1.24-4.76-4.15-4.9-4.34-.14-.19-1.17-1.55-1.17-2.96 0-1.4.73-2.09.99-2.38.26-.28.57-.35.76-.35.19 0 .38 0 .55.01.18.01.42-.07.65.5.24.58.81 1.99.88 2.13.07.14.12.31.02.5-.09.19-.14.31-.28.47-.14.16-.29.36-.42.48-.14.13-.28.28-.12.55.16.28.71 1.18 1.53 1.91 1.05.94 1.94 1.23 2.21 1.37.28.14.44.12.6-.07.16-.19.68-.79.86-1.06.18-.28.36-.23.6-.14.24.09 1.55.73 1.82.87.27.14.44.2.51.32.07.11.07.65-.17 1.33Z" />
                        </svg>
                        Consultar Stock por WhatsApp
                    </a>
                </div>
            </div>

        </div>

        {relacionados.length > 0 && (
                <div class="mt-20 border-t border-border pt-12">
                    <h2 class="text-2xl font-bold uppercase tracking-tight text-foreground">
                        Productos similares recomendados
                    </h2>
                    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
                        {relacionados.map((item) => (
                                <TarjetaProducto {...item} />
                        ))}
                    </div>
                </div>
        )}
    </section>

    <BotonWhatsappFlotante />
</Layout>