---
import { PRODUCTOS_POR_PAGINA } from "@/../config";
export const prerender = false;

import Layout from "@/layouts/Layout.astro";
import BotonWhatsappFlotante from "@/components/BotonWhatsappFlotante.astro";
import TarjetaProducto from "@/components/TarjetaProducto.astro";
import Paginacion from "@/components/Paginacion.astro";
import FiltroProductos from "@/components/FiltroProductos.astro";
import { obtenerProductos } from "@/data/productos";
import { negocio } from "@/data/negocio";
import banner_todos from "@/assets/todosProductos.webp";
import banner_auto from "@/assets/autoProductos.webp";
import banner_moto from "@/assets/motoProductos.webp";

const buscar = (Astro.url.searchParams.get("buscar") || "").trim();
const categoria = Astro.url.searchParams.get("categoria") || "todos";

const todosLosProductos = await obtenerProductos();

const textoBusqueda = buscar.toLowerCase();
const productosFiltrados = todosLosProductos.filter((p) => {
    const coincideTexto =
        !textoBusqueda ||
        p.nombre.toLowerCase().includes(textoBusqueda) ||
        p.descripcion.toLowerCase().includes(textoBusqueda);

    const coincideCategoria =
        categoria === "todos" ||
        p.categoria === categoria ||
        p.categoria === "ambos";

    return coincideTexto && coincideCategoria;
});

const totalPaginas = Math.max(
    1,
    Math.ceil(productosFiltrados.length / PRODUCTOS_POR_PAGINA),
);
const paginaSolicitada = Number(Astro.url.searchParams.get("pagina")) || 1;
const paginaActual = Math.min(Math.max(1, paginaSolicitada), totalPaginas);

const inicio = (paginaActual - 1) * PRODUCTOS_POR_PAGINA;
const productos = productosFiltrados.slice(
    inicio,
    inicio + PRODUCTOS_POR_PAGINA,
);

const paramsPaginacion = {
    ...(buscar ? { buscar } : {}),
    ...(categoria !== "todos" ? { categoria } : {}),
};

const banners = {
    moto: {
        src: banner_moto.src,
        titulo: "Mundo Moto",
        subtitulo: "Encuentra repuestos, aceites de alto rendimiento y accesorios diseñados específicamente para el cuidado y estilo de tu moto.",
        alt: "Motocicleta en carretera mostrando rendimiento y velocidad",
        etiqueta: "Especialidad 2 ruedas",
        cta: "Ver catálogo de motos"
    },
    auto: {
        src: banner_auto.src,
        titulo: "Mundo Auto",
        subtitulo: "Todo lo que tu vehículo necesita: baterías, filtros, lubricantes y repuestos de las mejores marcas para una mantención óptima.",
        alt: "Mecánico revisando el motor de un automóvil en el taller",
        etiqueta: "Mantención integral",
        cta: "Ver catálogo de autos"
    },
    todos: {
        src: banner_todos.src,
        titulo: "Catálogo de Productos",
        subtitulo: "Explora nuestro inventario completo. Contamos con stock actualizado de insumos y accesorios para mantener tu auto o moto al 100%.",
        alt: "Estanterías del lubricentro con bidones de aceite y repuestos",
        etiqueta: "Stock garantizado",
        cta: "Explorar todo"
    },
};

const banner = banners[categoria as keyof typeof banners] || banners.todos;
---

<Layout
        title={`${banner.titulo} | ${negocio.nombre}`}
        description={`Aceites, filtros, baterías y repuestos disponibles en ${negocio.direccion.comuna}. Consulta stock y precio por WhatsApp.`}
>
    <section class="relative border-b flex min-h-64 items-center overflow-hidden text-white">
        <div
                class="absolute inset-0 bg-cover bg-center"
                style={`background-image: url('${banner.src}');`}
        ></div>
        <div class="absolute inset-0 bg-black/70"></div>

        <div class="relative mx-auto w-full max-w-7xl px-6 py-10">
            <h1 class="text-3xl font-bold uppercase tracking-wide md:text-4xl">
                {banner.titulo}
            </h1>
            <p class="mt-3 max-w-2xl text-muted">
                {banner.subtitulo}
            </p>
        </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 py-14">
        <FiltroProductos
                action="/productos"
                buscar={buscar}
                categoria={categoria}
                mostrarCategoria={true}
                totalResultados={productosFiltrados.length}
        />

        {
            todosLosProductos.length === 0 ? (
                    <p class="mt-8 text-center text-sm text-muted-foreground">
                        No pudimos cargar el catálogo en este momento. Escríbenos por WhatsApp y te ayudamos directo.
                    </p>
            ) : productosFiltrados.length === 0 ? (
                    <p class="mt-8 text-center text-sm text-muted-foreground">
                        No encontramos productos que coincidan con tu búsqueda. Intenta con otros términos.
                    </p>
            ) : (
                    <>
                        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
                            {productos.map((p) => (
                                    <TarjetaProducto {...p} />
                            ))}
                        </div>

                        <div class="mt-12">
                            <Paginacion
                                    paginaActual={paginaActual}
                                    totalPaginas={totalPaginas}
                                    basePath="/productos"
                                    params={paramsPaginacion}
                            />
                        </div>
                    </>
            )
        }
    </section>

    <BotonWhatsappFlotante />
</Layout>