---
import Layout from "../layouts/Layout.astro";
import BotonWhatsappFlotante from "../components/BotonWhatsappFlotante.astro";
import TarjetaServicio from "../components/TarjetaServicio.astro";
import TarjetaProducto from "../components/TarjetaProducto.astro";
import { obtenerServicios } from "@/data/servicios";
import { obtenerProductos } from "@/data/productos";
import { negocio, linkWhatsapp } from "@/data/negocio";

import { Image } from 'astro:assets';
import heroMoto from "../assets/hero-moto.webp";
import mundoMoto from "../assets/mundo-moto.webp";
import mundoAuto from "../assets/mundo-auto.webp";

import { buttonVariants } from '@/components/ui/button';

const productos = await obtenerProductos();
const servicios = await obtenerServicios();
---

<Layout
    title={`${negocio.nombre} — Lubricentro y repuestos en ${negocio.direccion.comuna}`}
    description={`${negocio.eslogan} Cambio de aceite, frenos, diagnóstico y repuestos en ${negocio.direccion.comuna}. Cotiza por WhatsApp.`}
>
  <section class="relative isolate overflow-hidden text-white">
    <Image
        src={heroMoto}
        alt="Hero de Moto"
        sizes="100vw"
        loading="eager"
        class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
    />
    <div class="absolute inset-0 -z-10 bg-black/80"></div>

    <div
        class="relative mx-auto grid max-w-7xl items-center gap-10 px-6 py-20 md:grid-cols-2 md:py-28"
    >
      <div>
        <h1
            class="text-4xl font-bold uppercase leading-tight tracking-wide md:text-5xl md:leading-[1.1]"
        >
          {negocio.nombre}
        </h1>
        <p class="mt-5 max-w-md text-base text-gray-300">
          Mantención, repuestos y diagnóstico en {negocio.direccion.comuna}.
          Cuéntanos qué necesita tu vehículo y te cotizamos por WhatsApp.
        </p>
        <a
            href={linkWhatsapp(
                "Hola, quiero cotizar una mantención para mi auto.",
            )}
            target="_blank"
            rel="noopener noreferrer"
            class={buttonVariants({ size: 'lg', className: 'mt-8 uppercase tracking-wide' })}
        >
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
          <path
              d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.28-1.38a9.9 9.9 0 0 0 4.76 1.21h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm5.8 14.06c-.24.68-1.4 1.3-1.93 1.38-.5.08-1.12.11-1.8-.11-.42-.13-.95-.3-1.64-.6-2.88-1.24-4.76-4.15-4.9-4.34-.14-.19-1.17-1.55-1.17-2.96 0-1.4.73-2.09.99-2.38.26-.28.57-.35.76-.35.19 0 .38 0 .55.01.18.01.42-.07.65.5.24.58.81 1.99.88 2.13.07.14.12.31.02.5-.09.19-.14.31-.28.47-.14.16-.29.36-.42.48-.14.13-.28.28-.12.55.16.28.71 1.18 1.53 1.91 1.05.94 1.94 1.23 2.21 1.37.28.14.44.12.6-.07.16-.19.68-.79.86-1.06.18-.28.36-.23.6-.14.24.09 1.55.73 1.82.87.27.14.44.2.51.32.07.11.07.65-.17 1.33Z"
          />
        </svg>
          Cotizar por WhatsApp
        </a>
      </div>

      <div class="rounded-xl border border-white/20 bg-black/40 p-6 backdrop-blur-md">
        <p
            class="text-sm font-semibold uppercase tracking-wide text-gray-300"
        >
          Horario de atención
        </p>
        <ul class="mt-4 space-y-2 text-sm text-white">
          {
            negocio.horario.map((h) => (
                <li class="flex justify-between border-b border-white/10 last:border-0 last:pb-0">
                  <span class="font-medium text-gray-200">{h.dias}</span>
                  <span>{h.horas}</span>
                </li>
            ))
          }
        </ul>
        <p
            class="mt-6 text-sm font-semibold uppercase tracking-wide text-gray-300"
        >
          Dirección
        </p>
        <p class="mt-1 text-sm text-white">
          {negocio.direccion.calle}, {negocio.direccion.comuna}
        </p>
        <a
            href={negocio.googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 flex w-fit items-center gap-2 text-sm font-semibold text-primary transition-colors hover:text-white hover:underline"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          Ver en Google Maps
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-16">
    <div class="flex items-end justify-between">
      <h2
          class="text-2xl font-bold uppercase tracking-tight text-foreground"
      >
        Servicios
      </h2>
      <a
          href="/servicios"
          class="text-sm font-semibold text-primary transition-colors hover:text-primary/80 hover:underline"
      >
        Ver todos
      </a>
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {servicios.slice(0, 4).map((s) => <TarjetaServicio {...s} />)}
    </div>
  </section>

  <section class="grid text-white md:grid-cols-2">
    <a
        href="/productos?categoria=moto"
        class="group relative isolate flex min-h-96 items-end overflow-hidden p-10"
    >
      <Image
          src={mundoMoto}
          alt="Mundo Moto"
          sizes="(max-width: 768px) 100vw, 50vw"
          class="absolute inset-0 -z-10 h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
      />
      <div
          class="absolute inset-0 -z-10 bg-black/70 transition-colors duration-500 group-hover:bg-black/50"
      >
      </div>
      <div>
        <p
            class="text-3xl font-bold uppercase tracking-wide"
        >
          Mundo Moto
        </p>
        <p class="mt-2 max-w-xs text-sm text-gray-300">
          Mantención, repuestos y accesorios para tu moto.
        </p>
        <span
            class="mt-6 inline-block border-b-2 border-primary pb-1 text-sm font-bold uppercase tracking-wide transition-colors group-hover:text-primary"
        >
          Ver catálogo
        </span>
      </div>
    </a>

    <a
        href="/productos?categoria=auto"
        class="group relative isolate flex min-h-96 items-end overflow-hidden p-10"
    >
      <Image
          src={mundoAuto}
          alt="Mundo Auto"
          sizes="(max-width: 768px) 100vw, 50vw"
          class="absolute inset-0 -z-10 h-full w-full object-cover object-center transition-transform duration-700 group-hover:scale-105"
      />
      <div
          class="absolute inset-0 -z-10 bg-black/70 transition-colors duration-500 group-hover:bg-black/50"
      >
      </div>
      <div>
        <p
            class="text-3xl font-bold uppercase tracking-wide"
        >
          Mundo Auto
        </p>
        <p class="mt-2 max-w-xs text-sm text-gray-300">
          Mantención, repuestos y diagnóstico para tu auto.
        </p>
        <span
            class="mt-6 inline-block border-b-2 border-primary pb-1 text-sm font-bold uppercase tracking-wide transition-colors group-hover:text-primary"
        >
          Ver catálogo
        </span>
      </div>
    </a>
  </section>

  <section class="bg-muted/50 py-16">
    <div class="mx-auto max-w-7xl px-6">
      <div class="flex items-end justify-between">
        <h2
            class="text-2xl font-bold uppercase tracking-tight text-foreground"
        >
          Productos
        </h2>
        <a
            href="/productos"
            class="text-sm font-semibold text-primary transition-colors hover:text-primary/80 hover:underline"
        >
          Ver todos
        </a>
      </div>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {productos.slice(-4).reverse().map((p) => <TarjetaProducto {...p} />)}
      </div>
    </div>
  </section>

  <BotonWhatsappFlotante />
</Layout>