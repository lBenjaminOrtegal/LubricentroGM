---
import Layout from '../layouts/Layout.astro';
import BotonWhatsappFlotante from '../components/BotonWhatsappFlotante.astro';
import TarjetaServicio from '../components/TarjetaServicio.astro';
import TarjetaProducto from '../components/TarjetaProducto.astro';
import { servicios } from '../data/servicios.js';
import { productos } from '../data/productos.js';
import { negocio, linkWhatsapp } from '../data/negocio.js';
import { getImage } from 'astro:assets';
import heroMotoSrc from '../assets/hero/hero-moto.png';
import mundoMotoSrc from '../assets/mundo/mundo-moto.jpg';
import mundoAutoSrc from '../assets/mundo/mundo-auto.jpg';

const heroMoto = await getImage({ src: heroMotoSrc, width: 1600, format: 'webp' });
const mundoMoto = await getImage({ src: mundoMotoSrc, width: 1000, format: 'webp' });
const mundoAuto = await getImage({ src: mundoAutoSrc, width: 1000, format: 'webp' });
---

<Layout
  title={`${negocio.nombre}`}
  description={`${negocio.eslogan} Cambio de aceite, frenos, diagnóstico y repuestos en ${negocio.direccion.comuna}. Cotiza por WhatsApp.`}
>
  <section class="relative overflow-hidden bg-asfalto-950 text-white">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style={`background-image: url(${heroMoto.src});`}
    >
    </div>
    <div class="absolute inset-0 bg-asfalto-950/80"></div>

    <div class="relative mx-auto grid max-w-content items-center gap-10 px-6 py-20 md:grid-cols-2 md:py-28">
      <div>
        <h1 class="font-display text-4xl font-semibold uppercase leading-[1.05] tracking-wide md:text-5xl">
          Lubricentro G&M
        </h1>
        <p class="mt-5 max-w-md text-base text-acero-300">
          Mantención, repuestos y diagnóstico en {negocio.direccion.comuna}.
          Cuéntanos qué necesita tu vehículo y te cotizamos por WhatsApp.
        </p>
        <a
          href={linkWhatsapp('Hola, quiero cotizar una mantención para mi auto.')}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-md mt-8 inline-block bg-senal px-6 py-3 font-body text-sm font-semibold uppercase tracking-wide text-white hover:bg-senal-dark"
        >
          Cotizar por WhatsApp
        </a>
      </div>

      <div class="border border-white/10 p-6">
        <p class="font-display text-sm font-semibold uppercase tracking-wide text-acero-500">
          Horario de atención
        </p>
        <ul class="mt-3 space-y-1 text-sm text-acero-100">
          {negocio.horario.map((h) => (
            <li>{h.dias}: {h.horas}</li>
          ))}
        </ul>
        <p class="mt-4 font-display text-sm font-semibold uppercase tracking-wide text-acero-500">
          Dirección
        </p>
        <p class="mt-1 text-sm text-acero-100">
          {negocio.direccion.calle}, {negocio.direccion.comuna}
        </p>
        <a
          href={negocio.googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 inline-block text-sm font-semibold text-senal-light hover:underline"
        >
          Cómo llegar
        </a>
      </div>
    </div>
  </section>

  <!-- Servicios -->
  <section class="mx-auto max-w-content px-6 py-16">
    <div class="flex items-end justify-between">
      <h2 class="font-display text-2xl font-semibold uppercase tracking-wide text-asfalto-900">
        Servicios
      </h2>
      <a href="/servicios" class="text-sm font-semibold text-senal hover:underline">Ver todos</a>
    </div>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {servicios.slice(0, 4).map((s) => <TarjetaServicio {...s} />)}
    </div>
  </section>

  <!-- Mundo Moto / Mundo Auto -->
  <section class="grid text-white md:grid-cols-2">
    <a
      href="/mundo-moto"
      class="group relative isolate flex min-h-88 items-end overflow-hidden bg-asfalto-950 p-8"
    >
      <div
        class="absolute inset-0 -z-10 bg-cover bg-center transition-transform duration-500 group-hover:scale-105"
        style={`background-image: url(${mundoMoto.src});`}
      >
      </div>
      <div class="absolute inset-0 -z-10 bg-asfalto-950/70 transition-colors group-hover:bg-asfalto-950/60"></div>
 
      <div>
        <p class="font-display text-2xl font-semibold uppercase tracking-wide md:text-3xl">
          Mundo Moto
        </p>
        <p class="mt-2 max-w-xs text-sm text-acero-300">
          Mantención, repuestos y accesorios para tu moto.
        </p>
        <span class="mt-4 inline-block border-b-2 border-senal font-body text-sm font-semibold uppercase tracking-wide">
          Ver catálogo
        </span>
      </div>
    </a>
 
    <a
      href="/mundo-auto"
      class="group relative isolate flex min-h-88 items-end overflow-hidden bg-asfalto-950 p-8"
    >
      <div
        class="absolute inset-0 -z-10 bg-cover bg-center transition-transform duration-500 group-hover:scale-105"
        style={`background-image: url(${mundoAuto.src});`}
      >
      </div>
      <div class="absolute inset-0 -z-10 bg-asfalto-950/70 transition-colors group-hover:bg-asfalto-950/60"></div>
 
      <div>
        <p class="font-display text-2xl font-semibold uppercase tracking-wide md:text-3xl">
          Mundo Auto
        </p>
        <p class="mt-2 max-w-xs text-sm text-acero-300">
          Mantención, repuestos y diagnóstico para tu auto.
        </p>
        <span class="mt-4 inline-block border-b-2 border-senal font-body text-sm font-semibold uppercase tracking-wide">
          Ver catálogo
        </span>
      </div>
    </a>
  </section>

  <!-- Productos -->
  <section class="bg-acero-100/40 py-16">
    <div class="mx-auto max-w-content px-6">
      <div class="flex items-end justify-between">
        <h2 class="font-display text-2xl font-semibold uppercase tracking-wide text-asfalto-900">
          Productos
        </h2>
        <a href="/productos" class="text-sm font-semibold text-senal hover:underline">Ver todos</a>
      </div>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {productos.slice(0, 4).map((p) => <TarjetaProducto {...p} />)}
      </div>
    </div>
  </section>

  <BotonWhatsappFlotante />
</Layout>