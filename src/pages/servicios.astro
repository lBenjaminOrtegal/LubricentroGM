---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import BotonWhatsappFlotante from '../components/BotonWhatsappFlotante.astro';
import TarjetaServicio from '../components/TarjetaServicio.astro';
import { obtenerServicios } from '@/data/servicios';
import { negocio } from '@/data/negocio';
import serviciosImg from '@/assets/servicios.webp';

const servicios = await obtenerServicios();
---

<Layout
    title={`Servicios de mantención | ${negocio.nombre}`}
    description={`Cambio de aceite, frenos, alineación y diagnóstico computarizado en ${negocio.direccion.comuna}. Cotiza por WhatsApp.`}
>
  <section class="relative border-b flex min-h-64 items-center overflow-hidden text-white">
    <div
        class="absolute inset-0 bg-cover bg-center"
        style={`background-image: url('${serviciosImg.src}');`}
    ></div>
    <div class="absolute inset-0 bg-black/70"></div>

    <div class="relative mx-auto w-full max-w-7xl px-6 py-10">
      <h1 class="text-3xl font-bold uppercase tracking-wide md:text-4xl">
        Servicios
      </h1>
      <p class="mt-3 max-w-2xl text-muted">
        Los precios son referenciales: el valor final depende del modelo y estado de tu vehículo.
        Escríbenos por WhatsApp para una cotización exacta.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-12 md:py-16">
    {servicios.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {servicios.map((s) => <TarjetaServicio {...s} />)}
        </div>
    ) : (
        <div class="flex min-h-[40vh] flex-col items-center justify-center rounded-xl border border-dashed border-border bg-muted/10 p-8 text-center">
          <p class="text-lg font-semibold text-foreground">No hay servicios disponibles</p>
          <p class="mt-2 max-w-md text-sm text-muted-foreground">
            No pudimos cargar los servicios en este momento. Escríbenos por WhatsApp y te ayudamos directo.
          </p>
        </div>
    )}
  </section>

  <BotonWhatsappFlotante />
</Layout>