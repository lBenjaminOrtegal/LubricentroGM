---
import Layout from '../layouts/Layout.astro';
import { negocio } from '@/data/negocio';
import { obtenerServicios } from '@/data/servicios';
import { buttonVariants } from '@/components/ui/button';

const servicios = await obtenerServicios();

// Mapeo ligero de nombre -> descripción para el cliente
const mapaServicios = servicios.map((s) => ({
  nombre: s.nombre,
  descripcion: s.descripcion ?? '',
}));
---

<Layout
    title={`Cotizar servicio | ${negocio.nombre}`}
    description="Ingresa los datos de tu vehículo para que te coticemos por WhatsApp con toda la información lista."
>
  <section class="border-b flex min-h-64 items-center overflow-hidden bg-muted">
    <div class="relative mx-auto text-center w-full max-w-7xl px-6 py-10">
      <h1 class="text-3xl font-bold uppercase tracking-wide md:text-4xl">
        Cotizar servicio
      </h1>
      <p class="mt-3 text-base text-muted-foreground">
        Completa los datos de tu vehículo y te enviaremos el presupuesto exacto por WhatsApp.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-xl px-6 py-4">
    <div id="servicio-info" class="mt-4 hidden flex-col items-center text-center gap-2">
      <span class="inline-flex items-center gap-2 rounded-full border border-border bg-muted px-4 py-2 text-sm font-medium text-foreground shadow-sm">
        <strong id="servicio-nombre" class="font-bold uppercase tracking-tight"></strong>
      </span>
      <p id="servicio-descripcion" class="text-sm text-muted-foreground max-w-md hidden py-2"></p>
    </div>

    <div class="my-8 rounded-xl border border-border bg-card p-6 shadow-sm sm:p-8">
      <form id="form-cotizar" class="flex flex-col gap-6">
        <div class="space-y-2">
          <label for="nombre" class="text-sm font-medium leading-none text-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-70">
            Tu nombre
          </label>
          <input
              id="nombre"
              name="nombre"
              type="text"
              required
              class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
          />
        </div>

        <div class="grid grid-cols-2 gap-5">
          <div class="space-y-2">
            <label for="marca" class="text-sm font-medium leading-none text-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-70">
              Marca
            </label>
            <input
                id="marca"
                name="marca"
                type="text"
                placeholder="Ej: Chevrolet"
                required
                class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
            />
          </div>
          <div class="space-y-2">
            <label for="modelo" class="text-sm font-medium leading-none text-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-70">
              Modelo
            </label>
            <input
                id="modelo"
                name="modelo"
                type="text"
                placeholder="Ej: Sail"
                required
                class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
            />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-5">
          <div class="space-y-2">
            <label for="anio" class="text-sm font-medium leading-none text-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-70">
              Año
            </label>
            <input
                id="anio"
                name="anio"
                type="number"
                min="1970"
                max="2100"
                placeholder="Ej: 2018"
                required
                class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
            />
          </div>
          <div class="space-y-2">
            <label for="patente" class="text-sm font-medium leading-none text-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-70">
              Patente <span class="text-xs font-normal text-muted-foreground">(Opcional)</span>
            </label>
            <input
                id="patente"
                name="patente"
                type="text"
                placeholder="Ej: AB1234"
                class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm uppercase ring-offset-background placeholder:text-muted-foreground placeholder:normal-case focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
            />
          </div>
        </div>

        <div class="space-y-2">
          <label for="kilometraje" class="text-sm font-medium leading-none text-foreground peer-disabled:cursor-not-allowed peer-disabled:opacity-70">
            Kilometraje aprox. <span class="text-xs font-normal text-muted-foreground">(Opcional)</span>
          </label>
          <input
              id="kilometraje"
              name="kilometraje"
              type="text"
              placeholder="Ej: 85.000 km"
              class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
          />
        </div>

        <button
            type="submit"
            class={buttonVariants({ variant: 'default', size: 'lg', className: 'mt-4 w-full gap-2 font-semibold uppercase tracking-wide' })}
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.28-1.38a9.9 9.9 0 0 0 4.76 1.21h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm5.8 14.06c-.24.68-1.4 1.3-1.93 1.38-.5.08-1.12.11-1.8-.11-.42-.13-.95-.3-1.64-.6-2.88-1.24-4.76-4.15-4.9-4.34-.14-.19-1.17-1.55-1.17-2.96 0-1.4.73-2.09.99-2.38.26-.28.57-.35.76-.35.19 0 .38 0 .55.01.18.01.42-.07.65.5.24.58.81 1.99.88 2.13.07.14.12.31.02.5-.09.19-.14.31-.28.47-.14.16-.29.36-.42.48-.14.13-.28.28-.12.55.16.28.71 1.18 1.53 1.91 1.05.94 1.94 1.23 2.21 1.37.28.14.44.12.6-.07.16-.19.68-.79.86-1.06.18-.28.36-.23.6-.14.24.09 1.55.73 1.82.87.27.14.44.2.51.32.07.11.07.65-.17 1.33Z" />
          </svg>
          Continuar a WhatsApp
        </button>
      </form>
    </div>
  </section>
</Layout>

<script define:vars={{ telefono: negocio.telefonoWhatsapp, mapaServicios }}>
  const params = new URLSearchParams(window.location.search);
  const servicio = params.get('servicio');

  const contenedorInfo = document.getElementById('servicio-info');
  const nombreSpan = document.getElementById('servicio-nombre');
  const descParrafo = document.getElementById('servicio-descripcion');

  if (servicio && contenedorInfo && nombreSpan) {
    nombreSpan.textContent = servicio;
    contenedorInfo.classList.remove('hidden');
    contenedorInfo.classList.add('flex');

    const coincidencia = mapaServicios.find(
        (s) => s.nombre.toLowerCase() === servicio.toLowerCase()
    );

    if (coincidencia && coincidencia.descripcion && descParrafo) {
      descParrafo.textContent = coincidencia.descripcion;
      descParrafo.classList.remove('hidden');
    }
  }

  const form = document.getElementById('form-cotizar');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const nombre = form.nombre.value.trim();
    const marca = form.marca.value.trim();
    const modelo = form.modelo.value.trim();
    const anio = form.anio.value.trim();
    const patente = form.patente.value.trim().toUpperCase();
    const kilometraje = form.kilometraje.value.trim();

    const nombreServicio = servicio || 'una mantención';

    const lineas = [
      `¡Hola! Quería consultar por el servicio de ${nombreServicio}.`,
      '',
      `Nombre: ${nombre}`,
      `Vehículo: ${marca} ${modelo} (${anio})`,
    ];
    if (patente) lineas.push(`Patente: ${patente}`);
    if (kilometraje) lineas.push(`Kilometraje: ${kilometraje}`);
    lineas.push("¿Está disponible?");

    const mensaje = lineas.join('\n');
    window.open(`https://wa.me/${telefono}?text=${encodeURIComponent(mensaje)}`, '_blank');
  });
</script>