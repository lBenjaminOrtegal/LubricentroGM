---
import Layout from '../layouts/Layout.astro';
import BotonWhatsappFlotante from '../components/BotonWhatsappFlotante.astro';
import TarjetaProducto from '../components/TarjetaProducto.astro';
import { productos } from '../data/productos.js';
import { negocio, linkWhatsapp } from '../data/negocio.js';
import { getImage } from 'astro:assets';
import mundoMotoSrc from '../assets/mundo/mundo-moto.jpg';

const productosMoto = productos.filter((p) => p.categoria === 'moto' || p.categoria === 'ambos');
const banner = await getImage({ src: mundoMotoSrc, width: 1600, format: 'webp' });
---

<Layout
  title={`Mundo Moto | ${negocio.nombre}`}
  description={`Repuestos y accesorios exclusivos para moto en ${negocio.direccion.comuna}. Cotiza por WhatsApp.`}
>
  <section class="relative flex min-h-[16rem] items-end overflow-hidden bg-asfalto-950 text-white">
    <div class="absolute inset-0 bg-cover bg-center" style={`background-image: url(${banner.src});`}></div>
    <div class="absolute inset-0 bg-asfalto-950/70"></div>

    <div class="relative mx-auto w-full max-w-content px-6 py-10">
      <h1 class="font-display text-3xl font-semibold uppercase tracking-wide md:text-4xl">
        Mundo Moto
      </h1>
      <p class="mt-2 max-w-md text-sm text-acero-300">
        Repuestos, aceites y accesorios pensados para tu moto.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-content px-6 py-14">
    {productosMoto.length > 0 ? (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {productosMoto.map((p) => <TarjetaProducto {...p} />)}
      </div>
    ) : (
      <div class="border border-asfalto-800/10 bg-white p-8 text-center">
        <p class="text-sm text-asfalto-700">
          Estamos cargando el catálogo de Mundo Moto. Mientras tanto, escríbenos directo por WhatsApp.
        </p>
        <a
          href={linkWhatsapp('Hola, vengo por el Mundo Moto, quiero cotizar.')}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-block bg-senal px-6 py-3 font-body text-sm font-semibold uppercase tracking-wide text-white hover:bg-senal-dark"
        >
          Cotizar por WhatsApp
        </a>
      </div>
    )}
  </section>

  <BotonWhatsappFlotante />
</Layout>