---
import Layout from '../layouts/Layout.astro';
import BotonWhatsappFlotante from '../components/BotonWhatsappFlotante.astro';
import { negocio, linkWhatsapp, linkGmailCompose } from '@/data/negocio';
import { Image } from 'astro:assets';

import { buttonVariants } from '@/components/ui/button';

import local from '../assets/local.webp';

const canales = [
    {
        nombre: 'WhatsApp',
        detalle: 'Respuesta más rápida, la ideal para cotizar.',
        href: linkWhatsapp('Hola, quiero hacer una consulta.'),
        icono: 'whatsapp',
    },
    {
        nombre: 'Instagram',
        detalle: 'Síguenos y escríbenos por mensaje directo.',
        href: negocio.redes.instagram,
        icono: 'instagram',
    },
    {
        nombre: 'Correo',
        detalle: negocio.correo,
        href: linkGmailCompose({ asunto: 'Consulta desde el sitio web' }),
        icono: 'correo',
    },
];
---

<Layout
        title={`Contáctanos | ${negocio.nombre}`}
        description={`Escríbenos por WhatsApp, Instagram o correo. ${negocio.nombre} en ${negocio.direccion.comuna}.`}
>
    <section class="relative border-b flex min-h-64 items-center overflow-hidden bg-muted">
        <div class="relative mx-auto w-full max-w-7xl px-6 py-10">
            <h1 class="text-3xl font-bold uppercase tracking-wide md:text-4xl">
                Contáctanos
            </h1>
            <p class="mt-3 max-w-2xl">
                Elige el canal que prefieras. Para cotizaciones rápidas o dudas sobre stock, WhatsApp es la vía más
                directa.
            </p>
        </div>
    </section>
    <section class="mx-auto max-w-7xl px-6 py-6">
        <div class="mt-10 grid gap-6 sm:grid-cols-3">
            {canales.map((c) => (
                    <a
                            href={c.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="group flex flex-col gap-4 rounded-xl border border-border bg-card p-6 shadow-sm transition-all duration-300 hover:border-primary hover:shadow-md"
                    >
                    <span class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-muted text-muted-foreground transition-colors group-hover:bg-primary/10 group-hover:text-primary">
                        {c.icono === 'whatsapp' && (
                                <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true">
                                    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.28-1.38a9.9 9.9 0 0 0 4.76 1.21h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2Zm5.8 14.06c-.24.68-1.4 1.3-1.93 1.38-.5.08-1.12.11-1.8-.11-.42-.13-.95-.3-1.64-.6-2.88-1.24-4.76-4.15-4.9-4.34-.14-.19-1.17-1.55-1.17-2.96 0-1.4.73-2.09.99-2.38.26-.28.57-.35.76-.35.19 0 .38 0 .55.01.18.01.42-.07.65.5.24.58.81 1.99.88 2.13.07.14.12.31.02.5-.09.19-.14.31-.28.47-.14.16-.29.36-.42.48-.14.13-.28.28-.12.55.16.28.71 1.18 1.53 1.91 1.05.94 1.94 1.23 2.21 1.37.28.14.44.12.6-.07.16-.19.68-.79.86-1.06.18-.28.36-.23.6-.14.24.09 1.55.73 1.82.87.27.14.44.2.51.32.07.11.07.65-.17 1.33Z"/>
                                </svg>
                        )}
                        {c.icono === 'instagram' && (
                                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                                </svg>
                        )}
                        {c.icono === 'correo' && (
                                <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect width="20" height="16" x="2" y="4" rx="2"/>
                                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                                </svg>
                        )}
                    </span>
                        <div>
                            <p class="font-bold uppercase tracking-tight text-foreground">
                                {c.nombre}
                            </p>
                            <p class="mt-1 text-sm text-muted-foreground">{c.detalle}</p>
                        </div>
                    </a>
            ))}
        </div>

        <div class="mt-16 grid gap-12 border-t border-border pt-16 lg:grid-cols-2">
            <div class="flex flex-col">
                <h2 class="text-2xl font-bold uppercase tracking-wide text-foreground">
                    O escríbenos directo
                </h2>
                <p class="mt-2 text-sm text-muted-foreground">
                    Completa el formulario y se abrirá tu app de correo con el mensaje listo para enviar.
                </p>

                <form id="form-contacto" class="mt-8 flex flex-col gap-5">
                    <div class="space-y-2">
                        <label for="nombre" class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70 text-foreground">
                            Nombre
                        </label>
                        <input
                                id="nombre"
                                name="nombre"
                                type="text"
                                placeholder="Ej. Juan Pérez"
                                required
                                class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                        />
                    </div>

                    <div class="space-y-2">
                        <label for="mensaje" class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70 text-foreground">
                            Mensaje
                        </label>
                        <textarea
                                id="mensaje"
                                name="mensaje"
                                rows="5"
                                placeholder="¿En qué te podemos ayudar?"
                                required
                                class="flex min-h-30 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50"
                        ></textarea>
                    </div>

                    <button
                            type="submit"
                            class={buttonVariants({ variant: 'default', className: 'mt-2 self-start font-semibold uppercase tracking-wide' })}
                    >
                        Preparar correo
                    </button>
                </form>
            </div>

            <div class="flex flex-col">
                <h2 class="text-2xl font-bold uppercase tracking-wide text-foreground">
                    También puedes visitarnos
                </h2>
                <p class="mt-2 text-sm text-muted-foreground">
                    {negocio.direccion.calle}, {negocio.direccion.comuna}
                </p>

                <ul class="mt-6 space-y-2 text-sm text-muted-foreground">
                    {negocio.horario.map((h) => (
                            <li class="flex justify-between border-b border-border/50 pb-2 last:border-0">
                                <span class="font-medium text-foreground">{h.dias}</span>
                                <span>{h.horas}</span>
                            </li>
                    ))}
                </ul>

                <div class="mt-6 overflow-hidden rounded-xl border border-border shadow-sm">
                    <Image
                            src={local}
                            alt={`Fachada de ${negocio.nombre}`}
                            width={640}
                            height={480}
                            format="webp"
                            quality={80}
                            loading="lazy"
                            class="h-64 w-full object-cover transition-transform duration-700 hover:scale-105"
                    />
                </div>

                <a
                        href={negocio.googleMapsUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={buttonVariants({ variant: 'secondary', className: 'mt-6 self-start font-semibold uppercase tracking-wide' })}
                >
                    Ver en Google Maps
                </a>
            </div>
        </div>
    </section>

    <BotonWhatsappFlotante/>
</Layout>

<script define:vars={{ correo: negocio.correo }}>
    const form = document.getElementById('form-contacto');

    form?.addEventListener('submit', (e) => {
        e.preventDefault();

        const nombre = form.nombre.value.trim();
        const mensaje = form.mensaje.value.trim();

        const asunto = `Consulta de ${nombre} desde el sitio web`;
        const cuerpo = `${mensaje}\n\n—\nNombre: ${nombre}`;

        const params = new URLSearchParams({
            view: 'cm',
            fs: '1',
            to: correo,
            su: asunto,
            body: cuerpo,
        });

        window.open(`https://mail.google.com/mail/?${params.toString()}`, '_blank');
    });
</script>